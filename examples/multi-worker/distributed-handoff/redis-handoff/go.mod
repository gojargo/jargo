module github.com/gojargo/jargo/examples/multi-worker/distributed-handoff/redis-handoff

go 1.27

toolchain go1.27.4

// The example is a module of its own, so only it depends on a Redis client. It
// is developed against the library in the tree around it.
replace (
	github.com/gojargo/jargo => ../../../..
	github.com/gojargo/jargo/bus/network/redis => ../../../../bus/network/redis
)

