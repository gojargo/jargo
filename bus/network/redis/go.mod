module github.com/gojargo/jargo/bus/network/redis

go 1.27

toolchain go1.27.3

// Developed against the library in the tree around it, so a change to the bus
// and the Redis bus built on it land in one commit. A module depending on this
// one ignores the replacement and uses the version required below.
replace github.com/gojargo/jargo => ../../..

require (
	github.com/alicebob/miniredis/v2 v2.40.0
	github.com/gojargo/jargo v0.4.0
	github.com/redis/go-redis/v9 v9.23.0
)

require (
	github.com/cenkalti/backoff/v5 v5.0.3 // indirect
	github.com/cespare/xxhash/v2 v2.3.0 // indirect
